    "story": {
      "blocks": {
        "ch-grove": {
          "settings": {
            "image": "shopify://shop_images/story-pick.jpg",
            "kicker": "Etna, Sicily",
            "text": "<p>Our blood oranges come from three family groves on the slopes of Etna. They're picked in the six weeks of the year when the fruit is at its reddest.</p>"
          }
        },
        "ch-press": {
          "settings": {
            "image": "shopify://shop_images/story-juice.jpg",
            "kicker": "Within 24 hours",
            "heading": "Pressed, never concentrated",
            "text": "<p>Fruit is cold-pressed the day it arrives and goes straight into the tank. No concentrate and no flavorings to fill the gaps.</p>"
          }
        },
        "ch-can": {
          "settings": {
            "image": "shopify://shop_images/story-can.jpg",
            "kicker": "4,000 cans a run",
            "heading": "Canned in small batches",
            "text": "<p>Small runs keep every batch tasting like the last. The cans are aluminum, which recycles forever without losing quality.</p>"
          }
        }
      }
    },
